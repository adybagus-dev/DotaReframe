# Backend production env
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
FRONTEND_ORIGINS=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app
BACKEND_PUBLIC_URL=https://your-vercel-api.vercel.app
# For local backend runs, put GEMINI_API_KEY in `backend/.env.local` or `.env.local`.
GEMINI_API_KEY=
# Optional: overrides the Gemini model used for wording polish.
GEMINI_MODEL=gemini-2.5-flash-lite

# Frontend production env
BACKEND_URL=https://your-vercel-api.vercel.app
